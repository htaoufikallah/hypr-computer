#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
server() { exec uv run --quiet --script "$DIR/server.py" "$@"; }

case "${1:-help}" in
  update)  shift; exec bash "$DIR/install.sh" --update --dir="$DIR" "$@" ;;
  check)   server --check ;;
  version) server --version ;;
  stop)    server --stop ;;
  resume)  server --resume ;;
  allow)   shift; server --allow "$@" ;;
  watch)   server --watch ;;
  *)
    cat <<EOF
usage: hypr-computer <command>

  update    install the latest release (rolls back if it fails its self-check)
  check     self-check (clicks nothing, types no text)
  version   print the installed version
  stop      block every tool call of every running agent at once
  resume    allow actions again
  watch     show the workspace where you can watch the agent at work
  allow APP[,APP...] [--for 30m]
            let agents click and type only in these apps (window classes); screen reading still works
  allow --list    show what agents may use
  allow --off     let agents use every app again

Installed in $DIR
EOF
    [ "${1:-help}" = help ] || [ "${1:-}" = -h ] || [ "${1:-}" = --help ] || exit 2 ;;
esac
